# Normalize text to LF in the working tree / on checkout.
# Prevents shebang failures like: env: 'bash\r': No such file or directory
* text=auto eol=lf

*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.service text eol=lf
*.default text eol=lf

# Windows scripts intentionally use CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.vbs  text eol=crlf

# Leave binaries alone
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.step binary
*.stl  binary
