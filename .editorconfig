# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

# Windows batch / VBScript need CRLF
[*.{bat,cmd,vbs}]
end_of_line = crlf
